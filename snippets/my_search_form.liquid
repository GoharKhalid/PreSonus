  </svg>

  <input type="text" placeholder="Search" on:click="#search-modal/showDialog">
</div>

{% style %}
  .search-box {
    width: 200px;
    height: 40px;
    background: #f3f3f3;
    border-radius: 30px;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 0px;
    padding: 0 10px;
    box-sizing: border-box;
  }

  .search-box svg {
    flex-shrink: 0;
    color: #181818;
  }

  .search-box input {
    border: none;
    outline: none;
    background: transparent;
    font-family: "helvetica", sans-serif;
    font-size: 16px;
    color: #181818;
    width: 100%;
  }

  .search-box input::placeholder {
    color: #707070;
    opacity: 1;
  }
  @media screen and (max-width: 767px) {
    .search-box {display: none;
    }
  }
{% endstyle %}
