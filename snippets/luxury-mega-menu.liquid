<div class="custom-mega-menu">
  <div class="menu-container">
    <div class="menu-grid">

      {% for category in menu_item.links %}
        <div class="menu-column">

          <h4 class="menu-title">
            {{ category.title }}
          </h4>

          <div class="menu-line"></div>

          {% if category.links != blank %}
            <ul class="menu-links">

              {% for submenu_link in category.links %}
                <li class="menu-item">
                  <a
                    href="{{ submenu_link.url }}"
                    class="menu-link"
                  >
                    {{ submenu_link.title }}
                  </a>
                </li>
              {% endfor %}

            </ul>
          {% endif %}

        </div>
      {% endfor %}

    </div>
  </div>
</div>

<style>
  .custom-mega-menu,
  .custom-mega-menu * {
    animation: none !important;
    transition: none !important;
  }

  .custom-mega-menu {
    width: 100%;
    margin: 0;
    background: #ffffff;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.1);
    box-sizing: border-box;
  }

  .menu-container {
    width: 100%;
    padding: 40px 56px 45px;
    box-sizing: border-box;
  }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    width: 100%;
    gap: 0;
  }

  .menu-column {
    min-width: 0;
    padding: 0 28px;
    box-sizing: border-box;
  }

  .menu-title {
    margin: 0;
    color: #1d1d1d;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .menu-line {
    width: 100%;
    height: 1px;
    margin: 16px 0 18px;
    background: #d9d9d9;
  }

  .menu-links {
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }

  .menu-item {
    margin-bottom: 12px;
  }

  .menu-link {
    display: block;
    width: fit-content;
    color: #202020 !important;
    font-size: 14px;
    line-height: 1.45;
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    .menu-container {
      padding: 28px 20px;
    }

    .menu-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .menu-column {
      padding: 0;
    }
  }
</style>